config/.config/nushell/history.txt
.env
token.json
node_modules
lazy-lock.json
config/.local/state
config/.local/share/fish/
config/.local/share/karabiner/
config/.local/share/nvim/
config/.local/share/fonts/**/.uuid

# Keep only the Herdr configuration in Git.
/config/.config/herdr/*
!/config/.config/herdr/config.toml

/config/.claude/*
!/config/.claude/settings.json
!/config/.claude/CLAUDE.md
!/config/.claude/keybindings.json
!/config/.claude/statusline.sh

# Apps
/config/.local/share/applications/*
!/config/.local/share/applications/bluetui.desktop
!/config/.local/share/applications/wifitui.desktop
!/config/.local/share/applications/wiremix.desktop
